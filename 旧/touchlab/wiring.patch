diff --git a/public/sync/ipad.js b/public/sync/ipad.js
index 3ed9411..c25198d 100644
--- a/public/sync/ipad.js
+++ b/public/sync/ipad.js
@@ -122,4 +122,17 @@ addEventListener('pointerdown', (e) => sendTouch(e, true));
 addEventListener('pointermove', (e) => { if (e.buttons || e.pointerType === 'touch') sendTouch(e, true); });
 addEventListener('pointerup', (e) => sendTouch(e, false));
 addEventListener('pointercancel', (e) => sendTouch(e, false));
+// ---------------- every contact with its size, for the touch experiment (touchlab.html on the PC) ----------------
+// sent at 30 Hz while a finger is down (a still finger makes no events), only when that page is open
+const TC = { list: [], cancels: 0, sentOn: false, at: 0 };
+function touchList(e) {
+  TC.list = [...e.touches].slice(0, 10).map((t) => ({ x: (t.clientX - innerWidth / 2) * st.mmPerPx, y: (innerHeight / 2 - t.clientY) * st.mmPerPx, rx: (t.radiusX || 0) * st.mmPerPx, ry: (t.radiusY || 0) * st.mmPerPx, a: t.rotationAngle || 0, f: t.force || 0 }));
+}
+for (const n of ['touchstart', 'touchmove', 'touchend', 'touchcancel']) addEventListener(n, (e) => { if (n === 'touchcancel') TC.cancels++; touchList(e); }, { passive: true });
+setInterval(() => {
+  if (!link.presence.labs) return;
+  const on = TC.list.length > 0, now = performance.now();
+  if (!on && !TC.sentOn && now - TC.at < 300) return; // nothing down: a slow heartbeat only
+  TC.sentOn = on; TC.at = now; link.send({ type: 'touches', to: 'lab', t: now, list: TC.list, cancels: TC.cancels });
+}, 33);
 window.ipad = { P, st, display };
